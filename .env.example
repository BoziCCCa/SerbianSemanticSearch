# Copy this file to `.env` and adjust if needed.
# The Python scripts load these values via python-dotenv.

# Qdrant connection (the container exposes these ports on the host).
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Collection name used by the indexing and search scripts.
QDRANT_COLLECTION=serbian_wiki

# Embedding model (pulled from Hugging Face by sentence-transformers).
EMBEDDING_MODEL=intfloat/multilingual-e5-base
